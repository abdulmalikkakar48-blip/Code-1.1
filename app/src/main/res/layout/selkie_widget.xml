<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:padding="16dp" android:background="@drawable/selkie_widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/app_name"
        android:textColor="#EDF3FF" android:textStyle="bold" android:textSize="17sp" />
    <TextView android:id="@+id/widget_points" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#8DBEFF"
        android:textStyle="bold" android:textSize="22sp" android:maxLines="1" />
    <TextView android:id="@+id/widget_challenge" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical"
        android:textColor="#BBCBE2" android:textSize="14sp" android:maxLines="3"
        android:ellipsize="end" />
    <Button android:id="@+id/widget_action" android:layout_width="match_parent"
        android:layout_height="48dp" android:minHeight="48dp" android:padding="0dp"
        android:textColor="#081B33" android:textSize="14sp" android:textAllCaps="false"
        android:background="@drawable/selkie_widget_action" />
</LinearLayout>
